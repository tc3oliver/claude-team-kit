{
  "name": "claude-team-kit",
  "version": "0.1.3",
  "description": "A worker cap, role-based models and a team HUD for Claude Code's native Agent Teams. Lightweight, token-aware, portable.",
  "license": "MIT",
  "author": {
    "name": "tc3oliver",
    "url": "https://github.com/tc3oliver"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tc3oliver/claude-team-kit.git"
  },
  "homepage": "https://github.com/tc3oliver/claude-team-kit#readme",
  "bugs": {
    "url": "https://github.com/tc3oliver/claude-team-kit/issues"
  },
  "keywords": [
    "claude-code",
    "agent-teams",
    "claude-code-plugin",
    "statusline",
    "profile-sync",
    "cli"
  ],
  "type": "module",
  "bin": {
    "ctk": "dist/src/cli/bin.js"
  },
  "files": [
    "dist/src",
    "dist/plugins",
    "plugins",
    ".claude-plugin",
    "examples",
    "docs",
    "LICENSE",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "!**/.omc",
    "!plugins/ctk/tsconfig.json",
    "!plugins/ctk/tests",
    "!plugins/ctk/statusline/test",
    "!docs/assets/*.gif",
    "!docs/assets/*.mp4",
    "!docs/assets/*-poster.png",
    "!docs/assets/social-preview.png",
    "!docs/assets/*.frames.jsonl",
    "!docs/assets/mission-control-ui"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "ctk": "node dist/src/cli/bin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\" \"plugins/ctk/statusline/test/*.test.mjs\" \"scripts/media/**/*.test.mjs\"",
    "test:plugin": "claude plugin test plugins/ctk",
    "validate:plugin": "claude plugin validate plugins/ctk --strict && claude plugin validate . --strict",
    "check": "npm run typecheck && npm test && npm run test:plugin && npm run validate:plugin"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
